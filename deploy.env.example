# -*- coding: utf-8 -*-
# --------------------------------------------------------------------------
# Настройки деплоя marshrutka-watch (шаблон)
# --------------------------------------------------------------------------
# Скопируйте файл в deploy.env и поправьте значения под свой сервер.

# --- Сервер -----------------------------------------------------------------
HOST=77.105.135.146
SSH_USER=root
SSH_PORT=22
# Пароль берётся из окружения: export VPS_PASS=...   (в PowerShell: $env:VPS_PASS="...")

# --- Каталоги на сервере ----------------------------------------------------
REMOTE_DIR=/opt/marshrutka-watch
SNAPSHOT_DIR=/var/lib/marshrutka-watch
# Куда писать снимок прогноза (должен совпадать с snapshot_path в config.json)

# --- Что заливать -----------------------------------------------------------
FILES=marshrutka_watch.py webconfig.py
DEPLOY_CONFIG=0
DEPLOY_UNITS=0

# --- Сервисы ----------------------------------------------------------------
SERVICE_TRACKER=marshrutka-watch
SERVICE_WEB=marshrutka-web
SERVICE_USER=marshrutka
RESTART=1

# --- nginx ------------------------------------------------------------------
NGINX_SITE=/etc/nginx/sites-available/family-notes-https
PUBLIC_URL=https://77-105-135-146.sslip.io:8443/marshrutka/

# --- Локальный каталог с проектом -------------------------------------------
LOCAL_DIR=.

# --- Проверка после деплоя --------------------------------------------------
WAIT_SECONDS=5
