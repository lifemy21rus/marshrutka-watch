# -*- coding: utf-8 -*-
# --------------------------------------------------------------------------
# Настройки деплоя marshrutka-watch
# --------------------------------------------------------------------------
# Используется скриптом deploy.py. Значения — без кавычек, по одному на строку.
# Пароль сюда НЕ пишем: он берётся из переменной окружения VPS_PASS.
# --------------------------------------------------------------------------

# --- Сервер -----------------------------------------------------------------
HOST=77.105.135.146
SSH_USER=root
SSH_PORT=22
# Пароль берётся из окружения: export VPS_PASS=...   (в PowerShell: $env:VPS_PASS="...")

# --- Каталоги на сервере ----------------------------------------------------
REMOTE_DIR=/opt/marshrutka-watch
SNAPSHOT_DIR=/var/lib/marshrutka-watch
# Куда писать снимок прогноза (должен совпадать с snapshot_path в config.json)

# --- Что заливать -----------------------------------------------------------
# Файлы из локального каталога проекта (через пробел)
FILES=marshrutka_watch.py webconfig.py
# Заливать ли config.json (0 = нет, только код; 1 = да, вместе с настройками)
DEPLOY_CONFIG=0
# Заливать ли systemd-юниты
DEPLOY_UNITS=0

# --- Сервисы ----------------------------------------------------------------
SERVICE_TRACKER=marshrutka-watch
SERVICE_WEB=marshrutka-web
# Пользователь-владелец файлов на сервере (под ним работают сервисы)
SERVICE_USER=marshrutka
# Перезапускать ли сервисы после заливки
RESTART=1

# --- nginx ------------------------------------------------------------------
# Файл конфигурации сайта (для проверки location /marshrutka/)
NGINX_SITE=/etc/nginx/sites-available/family-notes-https
# Публичный адрес панели (для проверки после деплоя)
PUBLIC_URL=https://77-105-135-146.sslip.io:8443/marshrutka/

# --- Локальный каталог с проектом -------------------------------------------
LOCAL_DIR=.

# --- Проверка после деплоя --------------------------------------------------
# Сколько секунд подождать перед проверкой сервисов
WAIT_SECONDS=5
